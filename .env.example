# Copy to .env and fill in the secrets. Never commit .env (chmod 600 it).
# Every value is a string. Booleans must be exactly "true" or "false".
# Changes need an app restart. Empty values count as unset (the default applies).

# Server
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false
NODE_ENV=production

# Database (dedicated database and user, brainstorm section 6)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=MDpedia
DB_USER=MDpedia_app
DB_PASSWORD=

# Paths (absolute, outside the app folder, docs and staging on the same filesystem)
DOCS_DIR=/srv/MDpedia-data/docs
STAGING_DIR=/srv/MDpedia-data/staging
DATA_DIR=/srv/MDpedia-data

# Sessions (SESSION_SECRET: at least 32 characters, e.g. `openssl rand -hex 32`)
SESSION_SECRET=
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
PASSWORD_MIN_LENGTH=12

# AI provider (generic names so the provider can change). Not used before Phase 6.
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=
AI_CALL_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
AI_DAILY_CAP=200
AI_CONCURRENCY=1
AI_CIRCUIT_BREAKER_FAILURES=5

# Uploads (262144 bytes = 256 KB)
MAX_UPLOAD_BYTES=262144

# Ingest worker
JOB_POLL_INTERVAL_SECONDS=5
RECONCILE_INTERVAL_MINUTES=15
JOB_RETENTION_DAYS=30

# Rate limits
RATE_LOGIN_FAILS_PER_15MIN=5
RATE_SEARCH_PER_MIN=30
RATE_PAGES_PER_MIN=300
RATE_ADMIN_WRITES_PER_MIN=20

# Search
SEARCH_RESULT_LIMIT=100
SEARCH_PAGE_SIZE=10
SEARCH_PARTIAL_THRESHOLD=3
SEARCH_LOG_RETENTION_DAYS=90
SEARCH_WEIGHT_TITLE=5
SEARCH_WEIGHT_KEYWORD=3
SEARCH_WEIGHT_PHRASE=3
SEARCH_WEIGHT_SYNONYM=2
SEARCH_WEIGHT_QUESTION=2
SEARCH_WEIGHT_SUMMARY=2
SEARCH_WEIGHT_BODY=1

# Retention and backup
AUDIT_RETENTION_DAYS=365
BACKUP_STALE_DAYS=7
