<%- include('../partials/header') %>

<h1>Dashboard</h1>

<% if (notice) { %>
  <p class="notice notice-<%= notice.kind === 'ok' ? 'ok' : 'warn' %>"><%= notice.text %></p>
<% } %>

<%- include('../partials/ai-paused', { ai: ai }) %>

<div class="cards">
  <section class="card">
    <h2>Review queue</h2>
    <p><strong><%= docCounts.ready %></strong> awaiting review</p>
    <p><strong><%= pendingProposals %></strong> pending category proposal<%= pendingProposals === 1 ? '' : 's' %></p>
    <p><strong><%= ai.jobs.failed %></strong> failed job<%= ai.jobs.failed === 1 ? '' : 's' %>, <strong><%= docCounts.unpublished %></strong> unpublished</p>
    <p><a href="/admin/review">Review queue</a>, <a href="/admin/review?view=unpublished">unpublished</a>, <a href="/admin/import">bulk import</a></p>
  </section>
  <section class="card">
    <h2>Documents</h2>
    <p><strong><%= docCounts.ready %></strong> ready for review</p>
    <% if (docCounts.uploaded + docCounts.processing > 0) { %><p><strong><%= docCounts.uploaded + docCounts.processing %></strong> waiting for the AI</p><% } %>
    <% if (docCounts.failed > 0) { %><p><strong><%= docCounts.failed %></strong> failed, <a href="/admin/jobs?status=failed">see the jobs</a></p><% } %>
    <p><strong><%= docCounts.published %></strong> published, <strong><%= docCounts.unpublished %></strong> unpublished</p>
    <p><a href="/admin/docs">Manage documents</a> or <a href="/admin/docs/new">upload one</a></p>
  </section>
  <section class="card">
    <h2>Categories</h2>
    <p><strong><%= categoryCounts.categories %></strong> categories</p>
    <p><strong><%= categoryCounts.uncategorized %></strong> document<%= categoryCounts.uncategorized === 1 ? '' : 's' %> uncategorized</p>
    <p><a href="/admin/categories">Edit the category tree</a></p>
  </section>
  <section class="card">
    <h2>Links</h2>
    <p><strong><%= unresolvedLinks %></strong> unresolved link<%= unresolvedLinks === 1 ? '' : 's' %></p>
    <p><a href="/admin/links">See the report</a></p>
  </section>
  <section class="card">
    <h2>AI usage</h2>
    <% if (!ai.configured) { %>
      <p class="muted">Not configured. Set <code>AI_*</code> in <code>.env</code>.</p>
    <% } else { %>
      <p><strong><%= ai.usage.used %></strong> of <strong><%= ai.usage.cap %></strong> calls used today<% if (ai.usage.extra > 0) { %>, plus <strong><%= ai.usage.extra %></strong> allowed above the cap<% } %></p>
      <p><%= ai.jobs.queued %> queued, <%= ai.jobs.running %> running, <%= ai.jobs.failed %> failed</p>
      <% if (ai.waitingForCap) { %><p class="error-text">Cap reached: queued jobs wait until tomorrow.</p><% } %>
    <% } %>
    <p><a href="/admin/jobs">Jobs</a> or <a href="/admin/ai">AI Lab</a></p>
  </section>
  <section class="card">
    <h2>Last backup</h2>
    <p class="muted">Not tracked yet. Backup status arrives in Phase 10.</p>
  </section>
  <section class="card">
    <h2>Your session</h2>
    <p>Logged in as <strong><%= admin.username %></strong>.</p>
    <p class="muted">Ends after <%= idleMinutes %> idle minutes, or at <%= sessionExpires %> (server time) at the latest.</p>
  </section>
</div>

<h2>Recent activity</h2>
<% if (recent.length === 0) { %>
  <p class="muted">Nothing recorded yet.</p>
<% } else { %>
  <table class="log">
    <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Summary</th></tr></thead>
    <tbody>
      <% recent.forEach(function (r) { %>
        <tr><td><%= r.time %></td><td><%= r.actor %></td><td><code><%= r.action %></code></td><td><%= r.summary %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <p><a href="/admin/audit">Full audit log</a></p>
<% } %>

<%- include('../partials/footer') %>
