<%- include('../partials/header') %>

<h1><%= doc.title %></h1>

<% if (notice) { %>
  <p class="notice notice-<%= notice.kind === 'ok' ? 'ok' : 'warn' %>"><%= notice.text %></p>
<% } %>
<% if (errors.length > 0) { %>
  <div class="notice notice-error" role="alert">
    <ul>
      <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<table class="facts">
  <tr><th scope="row">Status</th><td><span class="badge badge-<%= doc.status %>"><%= doc.statusLabel %></span></td></tr>
  <tr><th scope="row">Slug</th><td>
    <code><%= doc.slug %></code> (permanent)
    <button type="button" class="link-button" data-copy="<%= doc.slug %>" aria-label="Copy the slug <%= doc.slug %>">Copy</button>
    <span class="field-note">Link to it from another document with <code>[[<%= doc.slug %>]]</code>.</span>
  </td></tr>
  <tr><th scope="row">Id</th><td><%= doc.id %></td></tr>
  <tr>
    <th scope="row">Reader links</th>
    <td>
      <% if (doc.published) { %>
        <a href="<%= readerPath %>"><%= readerPath %></a>,
        <a href="/doc?id=<%= doc.id %>">/doc?id=<%= doc.id %></a>
      <% } else { %>
        <span class="muted">none while the document is not published</span>
      <% } %>
    </td>
  </tr>
  <tr><th scope="row">Uploaded</th><td><%= doc.createdAt %></td></tr>
  <tr><th scope="row">Updated</th><td><%= doc.updatedAt %></td></tr>
  <% if (doc.publishedAt) { %><tr><th scope="row">Published</th><td><%= doc.publishedAt %></td></tr><% } %>
</table>

<% if (doc.hasRawHtml) { %>
  <p class="notice notice-warn">
    This document contains raw HTML. It is not rendered: the markup appears on the page as plain text.
  </p>
<% } %>

<h2>Visibility</h2>
<% if (doc.published) { %>
  <form class="inline-form" method="post" action="/admin/docs/<%= doc.id %>/unpublish">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="button">Unpublish</button>
  </form>
<% } else { %>
  <form class="inline-form" method="post" action="/admin/docs/<%= doc.id %>/publish">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="button"><%= doc.status === 'unpublished' ? 'Publish again' : 'Publish' %></button>
  </form>
<% } %>

<h2>Categories</h2>
<% if (categories.length === 0) { %>
  <p class="muted">Not filed under any category yet.</p>
<% } else { %>
  <ol class="doc-categories">
    <% categories.forEach(function (c) { %>
      <li>
        <%= c.label %>
        <% if (c.primary) { %><span class="badge badge-published">primary</span><% } %>
        <form class="inline-form" method="post" action="/admin/docs/<%= doc.id %>/categories/move">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="category_id" value="<%= c.id %>">
          <% if (c.canUp) { %><button type="submit" name="direction" value="up" class="link-button">Up</button><% } %>
          <% if (c.canDown) { %><button type="submit" name="direction" value="down" class="link-button">Down</button><% } %>
        </form>
        <form class="inline-form" method="post" action="/admin/docs/<%= doc.id %>/categories/remove">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="category_id" value="<%= c.id %>">
          <button type="submit" class="link-button">Remove</button>
        </form>
      </li>
    <% }) %>
  </ol>
<% } %>
<% if (categoryOptions.length > 0) { %>
  <form class="form form-wide" method="post" action="/admin/docs/<%= doc.id %>/categories/add">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="category_id">Add a category</label>
    <select id="category_id" name="category_id" required>
      <option value="">Choose a category</option>
      <% categoryOptions.forEach(function (o) { %><option value="<%= o.id %>"><%= o.label %></option><% }) %>
    </select>
    <p class="field-note">Up to <%= categoryMax %>; a further one is refused. The first is the primary category: it sets the breadcrumb and the document's URL.</p>
    <button type="submit">Add category</button>
  </form>
<% } else { %>
  <p class="field-note">There are no categories to add. <a href="/admin/categories">Create some first</a>.</p>
<% } %>

<h2>Title</h2>
<form class="form form-wide" method="post" action="/admin/docs/<%= doc.id %>/title" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="title">Title</label>
  <input id="title" name="title" type="text" value="<%= titleValue %>" maxlength="<%= titleMax %>" required>
  <p class="field-note">The slug stays the same.</p>
  <button type="submit">Save title</button>
</form>

<h2>Summary</h2>
<form class="form form-wide" method="post" action="/admin/docs/<%= doc.id %>/summary" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label for="summary">Summary</label>
  <textarea id="summary" name="summary" rows="4" maxlength="<%= summaryMax %>"><%= summaryValue %></textarea>
  <p class="field-note">
    Up to <%= summaryMax %> characters. Saving marks it as hand-edited. Leave it empty to clear it.
    <% if (doc.summaryEdited) { %><span class="badge badge-ready">hand-edited</span><% } %>
  </p>
  <button type="submit">Save summary</button>
</form>

<h2>Search keywords</h2>
<form class="form form-wide" method="post" action="/admin/docs/<%= doc.id %>/keywords" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p class="field-note">
    Plain text, one entry per line. They are searched next to the title, summary and body, and rank above a body-only match.
    A keyword may end with <code>| 1</code>, <code>| 2</code> or <code>| 3</code> to set its weight (1 when left out).
    A single letter such as <code>x</code> is searchable only as a keyword.
  </p>
  <% termLists.forEach(function (t) { %>
    <label for="terms-<%= t.list %>"><%= t.label.charAt(0).toUpperCase() + t.label.slice(1) %>s</label>
    <textarea id="terms-<%= t.list %>" name="<%= t.list %>" rows="<%= t.list === 'questions' ? 3 : 4 %>"><%= termsValue[t.list] %></textarea>
    <p class="field-note">Up to <%= t.max %>, each up to <%= t.length %> characters.</p>
  <% }) %>
  <button type="submit">Save search keywords</button>
</form>

<h2>Links in this document</h2>
<% if (links.length === 0) { %>
  <p class="muted">No <code>[[links]]</code>.</p>
<% } else { %>
  <% const unresolved = links.filter(function (l) { return l.state !== 'ok'; }).length; %>
  <% if (unresolved > 0) { %>
    <p class="notice notice-warn">
      <%= unresolved %> of <%= links.length %> link<%= links.length === 1 ? '' : 's' %> do not work yet.
      Check the slugs for typos. <a href="/admin/links">All unresolved links</a>
    </p>
  <% } %>
  <table class="log">
    <thead><tr><th>Links to</th><th>State</th></tr></thead>
    <tbody>
      <% links.forEach(function (l) { %>
        <tr>
          <td><code><%= l.slug %></code></td>
          <td>
            <% if (l.state === 'ok') { %>
              <span class="badge badge-published">works</span>
              <a href="/admin/docs/<%= l.targetId %>"><%= l.title %></a>
            <% } else if (l.state === 'unpublished') { %>
              <span class="badge badge-unpublished">document not published</span>
              <a href="/admin/docs/<%= l.targetId %>"><%= l.title %></a>
            <% } else { %>
              <span class="badge badge-warn">no document has this slug</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Preview</h2>
<div class="doc-body doc-preview">
  <%- doc.html %>
</div>

<%- include('../partials/footer') %>
