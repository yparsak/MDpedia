<%- include('partials/header') %>

<%- include('partials/breadcrumb', { crumbs: crumbs }) %>

<article class="doc">
  <h1><%= doc.title %></h1>
  <p class="muted doc-meta">Last updated <%= doc.updatedAt %></p>
  <% if (alsoIn.length > 0) { %>
    <p class="muted also-in">Also in:
      <% alsoIn.forEach(function (c, i) { %><%= i > 0 ? ', ' : '' %><a href="<%= c.url %>"><%= c.label %></a><% }) %>
    </p>
  <% } %>
  <div class="doc-body">
    <%- doc.html %>
  </div>
</article>

<% if (backlinks.length > 0) { %>
  <section class="backlinks" aria-labelledby="backlinks-heading">
    <h2 id="backlinks-heading">What links here</h2>
    <ul>
      <% backlinks.forEach(function (b) { %><li><a href="<%= b.url %>"><%= b.title %></a></li>
      <% }) %>
    </ul>
  </section>
<% } %>

<%- include('partials/footer') %>
