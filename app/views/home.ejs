<%- include('partials/header') %>

<h1>MDpedia</h1>

<% if (categories.length > 0) { %>
  <h2>Browse by category</h2>
  <%- include('partials/category-list', { categories: categories }) %>
<% } %>

<% if (docs.length === 0) { %>
  <p class="muted">No documents have been published yet.</p>
<% } else { %>
  <h2>All documents</h2>
  <ul class="doc-list">
    <% docs.forEach(function (d) { %>
      <li>
        <a href="<%= d.url %>"><%= d.title %></a>
        <% if (d.summary) { %><span class="doc-summary muted"><%= d.summary %></span><% } %>
      </li>
    <% }) %>
  </ul>
  <%- include('partials/pager', { basePath: '/?', page: page, pages: pages }) %>
<% } %>

<%- include('partials/footer') %>
