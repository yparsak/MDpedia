<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · MDpedia</title>
  <link rel="stylesheet" href="/css/style.css">
  <% (locals.styles || []).forEach(function (href) { %><link rel="stylesheet" href="<%= href %>">
  <% }) %>
  <% (locals.scripts || []).forEach(function (src) { %><script type="module" src="<%= src %>"></script>
  <% }) %>
</head>
<body>
<header class="site-header">
  <a class="brand" href="/">
    <img src="/imgs/logo.png" alt="" height="36">
    <span>MDpedia</span>
  </a>
  <form class="search-form" action="/search" method="get" role="search">
    <label class="visually-hidden" for="site-search">Search the wiki</label>
    <input id="site-search" name="q" type="search" value="<%= locals.query || '' %>" maxlength="200" placeholder="Search">
    <button type="submit">Search</button>
  </form>
  <% if (admin) { %>
  <nav class="site-nav" aria-label="Admin">
    <a href="/admin">Dashboard</a>
    <a href="/admin/docs">Documents</a>
    <a href="/admin/categories">Categories</a>
    <a href="/admin/search">Search</a>
    <a href="/admin/audit">Audit log</a>
    <a href="/admin/status">Status</a>
    <a href="/admin/password">Password</a>
    <form class="inline-form" method="post" action="/admin/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link-button">Log out (<%= admin.username %>)</button>
    </form>
  </nav>
  <% } %>
</header>
<main class="site-main">
